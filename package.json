{
  "name": "mcp-flowbench",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible MCP-backed tool orchestration benchmarks for OpenAI Agents JS",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "flowbench": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "format:check": "prettier --check .",
    "flowbench": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/agents": "0.22.0",
    "zod": "4.6.7"
  }
}
